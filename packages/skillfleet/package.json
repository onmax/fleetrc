  "keywords": [
    "agent-skills",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "gemini",
    "skills",
    "sync"
  ],
  "homepage": "https://github.com/onmax/skillfleet#readme",
  "bugs": "https://github.com/onmax/skillfleet/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/skillfleet.git",
    "directory": "packages/skillfleet"
  },
  "bin": {
    "skillfleet": "./dist/cli.mjs"
  },
  "files": [
